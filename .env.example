# ==============================================================================
# Discord Bot Environment Configuration
# Copy this file to .env and fill in the values below.
# ==============================================================================

# Discord bot token from Discord Developer Portal ("Bot" tab -> "Reset Token")
# REQUIRED!
DISCORD_TOKEN=your_discord_bot_token_here

# (Optional) Server ID for instant slash command sync during development.
# If left empty, commands will be synced globally (can take up to 1 hour).
DISCORD_GUILD_ID=

# Prefix for fallback text commands (default !)
BOT_PREFIX=!

# ------------------------------------------------------------------------------
# Spotify Web API Credentials (https://developer.spotify.com/dashboard)
# Required to fetch Spotify tracks, albums, and playlists metadata.
# If not specified, Spotify links will fall back to oEmbed or show a notice.
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ------------------------------------------------------------------------------
# Music Player Settings
# ------------------------------------------------------------------------------
# Default playback volume in percent (1 - 100)
DEFAULT_VOLUME=70

# Idle timeout (in seconds) in empty channel or when queue finishes
# before bot automatically disconnects from voice (300 sec = 5 minutes)
IDLE_TIMEOUT=300

# ------------------------------------------------------------------------------
# TikTok Module (Auto-embed and video downloading)
# ------------------------------------------------------------------------------
# Enable or disable TikTok link interception (true / false)
TIKTOK_ENABLED=true

# Mirror service for playback: vxtiktok.com, tnktok.com, tiktxk.com
TIKTOK_SERVICE=vxtiktok.com

# Auto-replace mode: "suppress" or "resend"
TIKTOK_REPLACE_MODE=suppress

# Automatically download and send TikTok as a native video file (true / false)
TIKTOK_SEND_VIDEO=true

# Delete original user message when TikTok link is detected (true / false)
TIKTOK_DELETE_ORIGINAL=true
