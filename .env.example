# ==============================================================================
# Discord Bot Environment Configuration
# Скопируйте этот файл в .env и заполните соответствующие значения.
# ==============================================================================

# Токен вашего Discord-бота из Discord Developer Portal (Вкладка "Bot" -> "Reset Token")
# ОБЯЗАТЕЛЬНО!
DISCORD_TOKEN=your_discord_bot_token_here

# (Опционально) ID сервера для мгновенной синхронизации слэш-команд при разработке.
# Если оставить пустым, команды будут синхронизированы глобально (может занять до 1 часа).
DISCORD_GUILD_ID=

# Префикс для резервных текстовых команд (по умолчанию !)
BOT_PREFIX=!

# ------------------------------------------------------------------------------
# Spotify Web API Credentials (https://developer.spotify.com/dashboard)
# Необходимы для извлечения метаданных треков/плейлистов/альбомов Spotify.
# Если не указаны, ссылки Spotify будут отклоняться с понятным предупреждением.
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ------------------------------------------------------------------------------
# Настройки музыкального плеера
# ------------------------------------------------------------------------------
# Громкость по умолчанию в процентах (1 - 100)
DEFAULT_VOLUME=70

# Время бездействия (в секундах) в пустом канале или после окончания очереди
# перед автоматическим выходом бота из голосового канала (300 сек = 5 минут)
IDLE_TIMEOUT=300

# ------------------------------------------------------------------------------
# Модуль TikTok (Автозамена ссылок на зеркала с поддержкой Discord Player)
# ------------------------------------------------------------------------------
# Включить/выключить перехват TikTok ссылок в сообщениях (true / false)
TIKTOK_ENABLED=true

# Зеркало для воспроизведения: vxtiktok.com, tnktok.com, tiktxk.com
TIKTOK_SERVICE=vxtiktok.com

# Режим автозамены:
# "suppress" - скрыть встроенное пустое превью Discord у сообщения пользователя и отправить зеркало
# "resend"   - удалить сообщение пользователя (требуются права Manage Messages) и отправить от его имени
TIKTOK_REPLACE_MODE=suppress

# Удалять ли исходное сообщение пользователя при нахождении ссылки TikTok (true / false)
# Если false и mode=suppress, оригинальное сообщение остаётся, но бот отправляет рабочее зеркало
TIKTOK_DELETE_ORIGINAL=false
